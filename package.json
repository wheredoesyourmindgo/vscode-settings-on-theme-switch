{
  "name": "vscode-settings-on-theme-switch",
  "displayName": "Settings on Theme Switch",
  "description": "Automatically apply different settings when switching between light and dark color themes.",
  "keywords": [
    "theme",
    "dark mode",
    "light mode",
    "color theme",
    "settings",
    "auto switch",
    "font weight"
  ],
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.89.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "properties": {
        "settingsOnThemeSwitch.darkColorThemeSettings": {
          "type": "object",
          "default": {},
          "markdownDescription": "Settings to apply when a dark color theme is active, as a map of setting ID to value. Example: `{ \"editor.fontWeight\": \"400\" }`.",
          "scope": "application"
        },
        "settingsOnThemeSwitch.lightColorThemeSettings": {
          "type": "object",
          "default": {},
          "markdownDescription": "Settings to apply when a light color theme is active, as a map of setting ID to value. Example: `{ \"editor.fontWeight\": \"500\" }`.",
          "scope": "application"
        }
      },
      "title": "Settings on Theme Switch"
    }
  },
  "publisher": "wheredoesyourmindgo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wheredoesyourmindgo/vscode-settings-on-theme-switch"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "^1.89.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "eslint": "8.57.1",
    "typescript": "5.9.3"
  },
  "homepage": "https://github.com/wheredoesyourmindgo/vscode-settings-on-theme-switch#readme",
  "bugs": {
    "url": "https://github.com/wheredoesyourmindgo/vscode-settings-on-theme-switch/issues"
  }
}
